{
  "name": "rs-physics-course",
  "private": true,
  "type": "module",
  "workspaces": [
    "course"
  ],
  "overrides": {
    "nf3": "0.3.17"
  },
  "scripts": {
    "dev": "npm run dev --workspace=course",
